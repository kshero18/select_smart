@model IEnumerable<MvcAdoDemo.Models.candidate>
@{
    ViewData["Title"] = "Index";
 }
 <h2>Index</h2>
 <p>
      <a asp-action="Create">Create New</a>
 </p>
 <table class="table">
     <thead>
         <tr>
             <th>
                 @Html.DisplayNameFor(model => model.Regno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                 @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phoneno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dept)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.skills)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yearofpassing)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CGPA)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Backlogs)
            </th>
            </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Regno)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Email)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Phoneno)
                        </td>
                        <th>
                            @Html.DisplayFor(model => item.Dept)
                        </th>
                        <th>
                            @Html.DisplayFor(model => item.skills)
                        </th>
                        <th>
                            @Html.DisplayFor(model => item.Yearofpassing)
                        </th>
                        <th>
                            @Html.DisplayFor(model => item.CGPA)
                        </th>
                        <th>
                            @Html.DisplayFor(model => item.Backlogs)
                        </th>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Regno">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.Regno">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.Regno">Delete</a>
                        </td>
                        </tr>
                        }
                        </tbody>
                        </table>